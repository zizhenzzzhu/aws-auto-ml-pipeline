DATA_PULL_MODE=cloud
DATA_SOURCE_TYPE=s3_csv
S3_INPUT_URI=s3://your-bucket-name/input/training.csv
CSV_HEADER=true
CSV_INFER_SCHEMA=true
DATA_PLATFORM_CATALOG=your_catalog
DATA_PLATFORM_SCHEMA=your_schema
DATA_PLATFORM_SECRET_NAME=your_aws_secret_name
DATA_PLATFORM_JDBC_DRIVER=com.databricks.client.jdbc.Driver
DATABRICKS_SERVER_HOSTNAME=your-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_TOKEN=your_local_pat_only_for_local_mode
AWS_REGION=us-west-2
PIPELINE_NAME=aws-auto-ml-pipeline
CLOUDWATCH_NAMESPACE=AutoMLPipeline
RAW_DATA_URI=data/raw
ETL_DATA_URI=data/etl
FEATURE_DATA_URI=data/features
PROCESSED_DATA_URI=data/processed
MODEL_DIR=outputs/model
METRICS_DIR=outputs/metrics
FEATURE_LOG_PATH=outputs/feature_log.json
